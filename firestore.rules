rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les appareils FireMap se connectent automatiquement avec Firebase Authentication anonyme.
    match /bornes/{borneId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Bloque toute autre collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
